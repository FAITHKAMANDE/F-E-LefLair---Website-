# --- Bookings storage (Supabase) -------------------------------------------
# Project Settings → API. The service-role key is SERVER-ONLY: never expose it
# with a NEXT_PUBLIC_ prefix. Without these, `npm run dev` falls back to a
# local file at .data/bookings.json (production refuses to start bookings).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (/bookings/admin) -----------------------------------------------
ADMIN_PASSWORD=
# Long random string, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
# IANA time zone the business's opening hours are in (default Africa/Nairobi).
# NEXT_PUBLIC_BOOKING_TIMEZONE=Africa/Nairobi
